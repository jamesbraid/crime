  "bases": [
    {"type": "constant", "lo": "0x14000000", "hi": "0x15000000", "window": "CRIME", "translate": true, "computed": true, "label": "constant address", "why": "CPU interface and memory controller registers (CRIME 1.5 specification, tables 5-7 and 6-12)"},
    {"type": "constant", "lo": "0x15000000", "hi": "0x16000000", "window": "RE", "translate": true, "computed": true, "label": "constant address", "why": "rendering engine (CRIME 1.5 specification, figure 7-3)"},
    {"type": "constant", "lo": "0x16000000", "hi": "0x17000000", "window": "GBE", "translate": true, "computed": true, "label": "constant address", "why": "display back end (GBE specification, section 3.1)"},
    {"type": "constant", "lo": "0x1f100000", "hi": "0x1f280000", "window": "MACEV", "translate": true, "computed": true, "label": "constant address", "why": "MACE video in 1, video in 2 and video out, three 0x80000 windows (Linux asm/ip32/mace.h struct sgi_mace)"},
    {"type": "constant", "lo": "0x1f400000", "hi": "0x1f800000", "window": "MACEAV", "translate": true, "computed": true, "label": "constant address", "why": "the audio and video block the CRIME specification system map lists at 0x1f400000"},
    {"type": "constant", "lo": "0x1f330000", "hi": "0x1f340000", "window": "MACEI2C", "translate": true, "computed": true, "label": "constant address", "why": "the MACE two-wire bus interface, sub-block 3 of the peripheral controller (MACE specification, peripheral controller sub-address map and the I2C interface registers)"},
    {"type": "field", "disp": 32184, "window": "RE", "label": "context +32184", "binaries": ["*libGLcore.so"], "why": "gc+32184 is the hardware pointer libGLcore stores register writes through (docs/context.md)"},
    {"type": "field", "disp": 120, "window": "RE", "label": "board record +120", "binaries": ["usr/cpu/sysgen/IP32boot/crime.a*"], "why": "board record +120 holds the KSEG1 pointer to 0x15000000 (crime_kernel/include/crime_kern.h CRB_RE_BASE)"},
    {"type": "field", "disp": 128, "window": "GBE", "label": "board record +128", "binaries": ["usr/cpu/sysgen/IP32boot/crime.a*"], "why": "board record +128 holds the KSEG1 pointer to the GBE window: crimeSetGammaRamp adds 0x60000 (the gamma map) to it and crimeBlankscreen adds 0x1002c (a flat-panel timing word)"},
    {"type": "global", "symbol": "crimeBoards", "disp": 4, "window": "GBE", "label": "crimeBoards+4", "binaries": ["usr/cpu/sysgen/IP32boot/crime.a*"], "why": "crimeBoards+4 holds the GBE KSEG1 base (crime_kernel/include/crime_kern.h)"},
    {"type": "argument", "function": "gbeProbe", "reg": 4, "window": "GBE", "label": "gbeProbe argument", "binaries": ["usr/cpu/sysgen/IP32boot/crime.a*"], "why": "gbeProbe reads the device id at +0x14 of its first argument and compares it with 0x666 (docs/gbe.md, GBE.h)"},
    {"type": "argument", "function": "crmSetSmask", "reg": 4, "window": "RE", "label": "crmSetSmask argument", "binaries": ["usr/lib/X11/dyDDX/crm.so"], "why": "all 23 callers in the X module pass the rendering-register mapping (word 0 of the module's screen private record) as the first argument; the scan cannot follow that two-level chain itself (docs/xmodule.md, register access)"},
    {"type": "argument", "function": "mvpi2c_reset", "reg": 4, "window": "MACEI2C", "label": "mvpi2c_reset argument", "binaries": ["usr/cpu/sysgen/IP32boot/mvp.o"], "why": "clears and re-arms the bus interface; its first argument is the bus interface base, which both chip objects of the driver hold at object +16 as 0xbf330000 (docs/mace-video.md, Driver access)"},
    {"type": "argument", "function": "mvpi2c_check", "reg": 4, "window": "MACEI2C", "label": "mvpi2c_check argument", "binaries": ["usr/cpu/sysgen/IP32boot/mvp.o"], "why": "polls the bus status; its first argument is the bus interface base, which both chip objects of the driver hold at object +16 as 0xbf330000 (docs/mace-video.md, Driver access)"},
    {"type": "argument", "function": "mvpi2c_read_reg", "reg": 4, "window": "MACEI2C", "label": "mvpi2c_read_reg argument", "binaries": ["usr/cpu/sysgen/IP32boot/mvp.o"], "why": "reads one chip register over the bus; its first argument is the bus interface base, which both chip objects of the driver hold at object +16 as 0xbf330000 (docs/mace-video.md, Driver access)"},
